# Frontend public config (Next.js)
# This file is safe to commit. Copy to .env.local and adjust as needed.

# API base URL used by Next.js server routes (login, proxy, AI endpoints).
# Local: el backend corre en :8001 (dev-up.sh); :8000 suele estar ocupado por Portainer.
# Producción (Vercel): https://<tu-app-en-railway>.up.railway.app
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Compatibilidad temporal con configuración antigua
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001

# Demo mode (optional)
NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
