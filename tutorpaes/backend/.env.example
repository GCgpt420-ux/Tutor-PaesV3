# ========================================================
# TutorPAES API - Environment Configuration
# ========================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to git.

# Application Settings
APP_NAME="TutorPAES API"
VERSION="2.0.0"
DEBUG=False

# ========================================================
# CRITICAL: Database Configuration
# ========================================================
# Format: postgresql+psycopg://user:password@host:port/dbname
# Local development example:
#   postgresql+psycopg://mvp:mvp@localhost:5432/mvp_db
# Railway example:
#   postgresql+psycopg://myuser:mypass@rail.proxy.rlwy.net:5432/railway
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database_name

# ========================================================
# CRITICAL: Security Configuration
# ========================================================
# Generate a new SECRET_KEY with: openssl rand -hex 32
# This is used for JWT token signing - MUST be kept secret!
SECRET_KEY=your-secret-key-generated-with-openssl-rand-hex-32

# JWT Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS Configuration (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=True
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ========================================================
# Demo/Bootstrap Data (Development Only)
# ========================================================
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123
PAES_CODE=PAES

# ========================================================
# API Configuration
# ========================================================
API_V1_PREFIX=/api/v1
QUIZ_TOPIC_MAX_QUESTIONS=15

# ========================================================
# OpenAI LLM Configuration (Optional)
# ========================================================
# Leave empty to disable LLM features and use rule-based feedback only
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_RETRIES=1
AI_ENABLE_LLM=True

# ========================================================
# CRITICAL: Transbank WebPay Plus Configuration
# ========================================================
# Integration mode: Testing keys (replace for production)
# Production mode: Use your actual merchant credentials
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=<TRANSBANK_INTEGRATION_API_KEY>
TBK_ENVIRONMENT=integration

# Payment Return Configuration
# URL where Transbank redirects after payment
# Example: https://tutorpaes.cl/api/v1/payments/confirm
PAYMENT_RETURN_URL=http://localhost:8000/api/v1/payments/confirm

# Frontend public URL (used for password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# ========================================================
# CRITICAL: SMTP / Email Provider Configuration
# ========================================================
# Replace with your actual SMTP credentials (e.g., SendGrid, Mailgun, Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tutorpaes.cl

# ========================================================
# Database Bootstrap (Development Only)
# ========================================================
# Set to True to auto-create tables on startup (use Alembic for production)
AUTO_CREATE_TABLES=False

# ========================================================
# Logging Configuration
# ========================================================
LOG_LEVEL=INFO
LOG_FILE=app.log

# ========================================================
# Optional: Sentry Error Tracking
# ========================================================
# Leave empty to disable Sentry
SENTRY_DSN=

# ========================================================
# Optional: Redis Configuration (for caching)
# ========================================================
# Used for rate limiting, session cache, etc.
# Local: redis://localhost:6379/0
# Upstash: redis://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# ========================================================
# Optional: Environment Detection
# ========================================================
# Values: development, staging, production
ENVIRONMENT=development
