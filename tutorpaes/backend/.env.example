# ========================================================
# TutorPAES API - Environment Configuration
# ========================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to git.

# Application Settings
APP_NAME="TutorPAES API"
VERSION="2.0.0"
DEBUG=False

# ========================================================
# CRITICAL: Database Configuration
# ========================================================
# Format: postgresql+psycopg://user:password@host:port/dbname
# Local development example:
#   postgresql+psycopg://mvp:mvp@localhost:5432/mvp_db
# Railway example:
#   postgresql+psycopg://myuser:mypass@rail.proxy.rlwy.net:5432/railway
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database_name
# Optional but recommended: separate migration user with DDL permissions/ownership.
# Alembic will prefer this URL over DATABASE_URL when running migrations.
ALEMBIC_DATABASE_URL=postgresql+psycopg://migration_user:password@localhost:5432/database_name

# DB pool per app worker (ignored by SQLite tests)
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

# ========================================================
# CRITICAL: Security Configuration
# ========================================================
# Generate a new SECRET_KEY with: openssl rand -hex 32
# This is used for JWT token signing - MUST be kept secret!
SECRET_KEY=your-secret-key-generated-with-openssl-rand-hex-32

# JWT Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS Configuration (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=True
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ========================================================
# Demo/Bootstrap Data (Development Only)
# ========================================================
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123
PAES_CODE=PAES

# ========================================================
# API Configuration
# ========================================================
API_V1_PREFIX=/api/v1
QUIZ_TOPIC_MAX_QUESTIONS=15

# ========================================================
# LLM Configuration (Multiple Providers Supported)
# ========================================================
# Proveedor principal: openai | groq | cerebras
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
AI_ENABLE_LLM=True

# OpenAI Configuration
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (Free tier available)
# Get key from: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=mixtral-8x7b-32768

# Cerebras Configuration (Free tier available)
# Get key from: https://cloud.cerebras.ai
CEREBRAS_API_KEY=csk_...
CEREBRAS_MODEL=llama-3.1-70b

# ========================================================
# CRITICAL: Transbank WebPay Plus Configuration
# ========================================================
# INTEGRATION (sandbox) — Valores públicos del SDK oficial Transbank.
# Usar estos para desarrollo y QA local. NO usar en producción.
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=<TRANSBANK_INTEGRATION_API_KEY>
TBK_ENVIRONMENT=integration

# PRODUCCIÓN — Reemplazar con credenciales reales del panel Transbank.
# Obtener en: https://www.transbankdevelopers.cl/onboarding
# TBK_COMMERCE_CODE=<tu_codigo_de_comercio>
# TBK_API_KEY=<tu_api_key_de_produccion>
# TBK_ENVIRONMENT=production

# Valores sandbox (solo lectura, usados internamente como guardrail de seguridad).
# Modificar solo si Transbank cambia sus credenciales oficiales de sandbox.
# TBK_INTEGRATION_COMMERCE_CODE=597055555532
# TBK_INTEGRATION_API_KEY=<TRANSBANK_INTEGRATION_API_KEY>

# Payment Return Configuration
# URL where Transbank redirects after payment
# Recomendado: callback del frontend para mantener contexto de sesión y luego
# confirmar en backend vía /api/payments/confirm.
# Ejemplo local:  http://localhost:3000/api/payments/confirm
# Ejemplo prod:   https://tutorpaes.cl/api/payments/confirm
PAYMENT_RETURN_URL=http://localhost:3000/api/payments/confirm

# Frontend public URL (used for password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# ========================================================
# CRITICAL: SMTP / Email Provider Configuration
# ========================================================
# Replace with your actual SMTP credentials (e.g., SendGrid, Mailgun, Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tutorpaes.cl

# ========================================================
# Database Bootstrap (Development Only)
# ========================================================
# Set to True to auto-create tables on startup (use Alembic for production)
AUTO_CREATE_TABLES=False

# ========================================================
# Logging Configuration
# ========================================================
LOG_LEVEL=INFO
LOG_FILE=app.log

# ========================================================
# Optional: Sentry Error Tracking
# ========================================================
# Leave empty to disable Sentry
SENTRY_DSN=

# ========================================================
# Optional: Redis Configuration (for caching)
# ========================================================
# Used for rate limiting, session cache, etc.
# Local: redis://localhost:6379/0
# Upstash: redis://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# ========================================================
# Optional: Environment Detection
# ========================================================
# Values: development, staging, production
ENVIRONMENT=development
